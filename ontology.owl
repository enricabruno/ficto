        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2"/>
    </owl:ObjectProperty>
    
    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasPart" -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasPart">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Narrative"/>
        <rdfs:range rdf:resource="https://example.org/ficto/NarrativeSegment"/>
    </owl:ObjectProperty>

    <!-- http://www.cidoc-crm.org/cidoc-crm/P72_has_language -->

    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P72">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E56_Language"/>
    </owl:ObjectProperty>
    
    <!-- http://www.cidoc-crm.org/cidoc-crm/P94_has_created -->

    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P94">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28"/>
        <rdfs:range rdf:resource="https://example.org/ficto/Narrative"/>
    </owl:ObjectProperty>
    
    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasRole -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasRole">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/fr/frbr/frbroo/F38_Character"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Role"/>
    </owl:ObjectProperty>

    <!-- http://www.w3.org/2004/02/skos/core#related -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#related">
        <rdfs:domain rdf:resource="https://example.org/ficto/AnagraphicalStatus"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/Axiology"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/CharacterAndPsychology"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/Modality"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/Praxis"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/Symbols"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    </owl:ObjectProperty>
    
    <!-- https://example.org/ficto/hasAttribute -->

    <owl:ObjectProperty rdf:about="https://example.org/ficto/hasAttribute">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/fr/frbr/frbroo/F38"/>
        <rdfs:range rdf:resource="https://example.org/ficto/Attribute"/>
        <rdfs:comment>This property allows to specify attributes of a character.</rdfs:comment>
        <rdfs:label>has Attribute</rdfs:label>
    </owl:ObjectProperty>

    <!-- https://example.org/ficto/hasNarrativeFunction -->

    <owl:ObjectProperty rdf:about="https://example.org/ficto/hasNarrativeFunction">
  <rdfs:domain rdf:resource="https://example.org/ficto/Character"/>
  <rdfs:range rdf:resource="https://example.org/ficto/Narrator"/>
  <rdfs:comment>This property expresses the possibility of a character to be the narrator of the story.</rdfs:comment>
        <rdfs:label>has Narrative Function</rdfs:label>
</owl:ObjectProperty>

    <!-- https://example.org/ficto/hasFormOfSpeech -->

    <owl:ObjectProperty rdf:about="https://example.org/ficto/hasFormOfSpeech">
        <rdfs:domain rdf:resource="https://example.org/ficto/NarrativeSegment"/>
        <rdfs:range rdf:resource="https://example.org/ficto/FormOfSpeech"/>
        <rdfs:comment>This property allows to specify the type of speech of a narrative segment.</rdfs:comment>
        <rdfs:label>has Form of Speech</rdfs:label>
    </owl:ObjectProperty>
    
    <!-- https://example.org/ficto/hasNarrativeIstance -->

    <owl:ObjectProperty rdf:about="https://example.org/ficto/hasNarrativeIstance">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/NarrativeSegment"/>
        <rdfs:range rdf:resource="https://example.org/ficto/Narrator"/>
        <rdfs:comment>This property allows to specify the perspective of a narrative segment from which the story conveys information.</rdfs:comment>
        <rdfs:label>has Perspective</rdfs:label>
    </owl:ObjectProperty>
    
    <!-- https://example.org/ficto/hasNarrativeLevel -->

    <owl:ObjectProperty rdf:about="https://example.org/ficto/hasNarrativeLevel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/Narrator"/>
        <rdfs:range rdf:resource="https://example.org/ficto/NarrativeLevel"/>
        <rdfs:comment>This property expresses the narrative level (i.e. first of second grade)</rdfs:comment>
        <rdfs:label>has Narrative Level</rdfs:label>
    </owl:ObjectProperty>

    <!-- https://example.org/ficto/hasNarrativePosition -->

    <owl:ObjectProperty rdf:about="https://example.org/ficto/hasNarrativePosition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/Narrator"/>
        <rdfs:range rdf:resource="https://example.org/ficto/NarrativePosition"/>
        <rdfs:comment>This property expresses the relatinships between the narrator and the narrated story.</rdfs:comment>
        <rdfs:label>has Narrative Position</rdfs:label>
    </owl:ObjectProperty>
    
    <!-- https://example.org/ficto/hasPointOfView -->

    <owl:ObjectProperty rdf:about="https://example.org/ficto/hasPointOfView">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/Narrator"/>
        <rdfs:range rdf:resource="https://example.org/ficto/Focalization"/>
        <rdfs:comment>This property expresses the position of the narrator in relation to the narrated story.</rdfs:comment>
        <rdfs:label>has Point Of View</rdfs:label>
    </owl:ObjectProperty>
    
    <!-- https://example.org/ficto/involves -->

    <owl:ObjectProperty rdf:about="https://example.org/ficto/involves">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/NarrativeSegment"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/fr/frbr/frbroo/F38"/>
        <rdfs:comment>This property expresses the possible presence of a character within a narrative segment.</rdfs:comment>
        <rdfs:label>involves</rdfs:label>
    </owl:ObjectProperty>

    <!-- https://example.org/ficto/isInspiredBy -->

    <owl:ObjectProperty rdf:about="https://example.org/ficto/isInspiredBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/fr/frbr/frbroo/F38"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/fr/frbr/frbroo/F38"/>
        <rdfs:comment>This property expresses an inspiration from a fictional character to another fictional character.</rdfs:comment>
        <rdfs:label>is Inspired By</rdfs:label>
    </owl:ObjectProperty>

    <!-- https://example.org/ficto/linkedTo -->

    <owl:ObjectProperty rdf:about="https://example.org/ficto/linkedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/Attribute"/>
        <rdfs:range rdf:resource="https://example.org/ficto/LiteraryGenre"/>
        <rdfs:comment>This property expresses a possible link between character attribute and the literary genre of reference.</rdfs:comment>
        <rdfs:label>linked To</rdfs:label>
    </owl:ObjectProperty>

    
