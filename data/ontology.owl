<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/ontology#"
     xml:base="http://www.example.org/ontology"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology/>
    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span -->
    <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>

    <!-- http://www.cidoc-crm.org/cidoc-crm/E56_Language -->
    <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E56_Language"/>

    <!-- http://iflastandards.info/ns/lrm/lrmoo/F27_Work_Creation -->
    <owl:Class rdf:about="http://iflastandards.info/ns/lrm/lrmoo/F27_Work_Creation"/>

    <!-- http://iflastandards.info/ns/lrm/lrmoo/F1_Work -->
    <owl:Class rdf:about="http://iflastandards.info/ns/lrm/lrmoo/F1_Work"/>

    <!-- http://iflastandards.info/ns/lrm/lrmoo/F2_Expression -->
    <owl:Class rdf:about="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>

    <!-- http://iflastandards.info/ns/lrm/lrmoo/F28_ExpressionCreation -->
    <owl:Class rdf:about="http://iflastandards.info/ns/lrm/lrmoo/F28_ExpressionCreation"/>

    <!-- http://www.cidoc-crm.org/cidoc-crm/E39_Actor -->
    <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>

    <!-- http://www.cidoc-crm.org/cidoc-crm/E55_Type -->
    <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>

    <!-- http://iflastandards.info/ns/lrm/lrmoo/F55_Collective_Agent -->
    <owl:Class rdf:about="http://iflastandards.info/ns/lrm/lrmoo/F55_Collective_Agent"/>

    <!-- https://example.org/ficto/Focalization -->
    <owl:Class rdf:about="https://example.org/ficto/Focalization">
        <rdfs:comment>The focalization is the point of view from which a story is narrated.</rdfs:comment>
        <rdfs:label>Focalization</rdfs:label>
    </owl:Class>

    <!-- https://example.org/ficto/Narrator -->
    <owl:Class rdf:about="https://example.org/ficto/Narrator">
        <rdfs:comment>The narrator is the voice narrating the facts.</rdfs:comment>
        <rdfs:label>Narrator</rdfs:label>
    </owl:Class>

    <!-- http://iflastandards.info/ns/fr/frbr/frbroo/F38_Character -->
    <owl:Class rdf:about="http://iflastandards.info/ns/fr/frbr/frbroo/F38_Character"/>

    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Role -->
    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Role"/>
    
    <!-- https://example.org/ficto/Diegesis -->
    <owl:Class rdf:about="https://example.org/ficto/Diegesis">
        <rdfs:comment>The diegesis is the narrative representation.</rdfs:comment>
        <rdfs:label>Diegesis</rdfs:label>
    </owl:Class>

    <!-- https://example.org/ficto/NarrativeSegment -->
    <owl:Class rdf:about="https://example.org/ficto/NarrativeSegment">
        <rdfs:comment>A narrative segment is a minimum unit of the story identified on the basis of their linguistic-functional characteristics.</rdfs:comment>
        <rdfs:label>Narrative Segment</rdfs:label>
    </owl:Class>

    <!-- https://example.org/ficto/Attribute -->
    <owl:Class rdf:about="https://example.org/ficto/Attribute">
        <rdfs:comment>An attribute is a character trait.</rdfs:comment>
        <rdfs:label>Attribute</rdfs:label>
    </owl:Class>

    <!-- https://example.org/ficto/LiteraryGenre -->
    <owl:Class rdf:about="https://example.org/ficto/LiteraryGenre">
        <rdfs:comment>A literary genre is a category of literary writing.</rdfs:comment>
        <rdfs:label>Literary Genre</rdfs:label>
    </owl:Class>

    <!-- https://example.org/ficto/FormOfSpeech -->
    <owl:Class rdf:about="https://example.org/ficto/FormOfSpeech">
        <rdfs:comment>A form of speech is the way how a narrative segment is narrated.</rdfs:comment>
        <rdfs:label>Source Type</rdfs:label>
    </owl:Class>

    <!-- https://example.org/ficto/AnagraphicalStatus -->
    <owl:Class rdf:about="https://example.org/ficto/AnagraphicalStatus">
        <rdfs:subClassOf rdf:resource="https://example.org/ficto/Attribute"/>
        <rdfs:comment>The anagraphical status includes: age, gender, name, physiognomy, socio-economic status, professional activity, etc.</rdfs:comment>
        <rdfs:label>Anagraphical Status</rdfs:label>
    </owl:Class>

    <!-- https://example.org/ficto/CharacterAndPsychology -->
    <owl:Class rdf:about="https://example.org/ficto/CharacterAndPsychology">
        <rdfs:subClassOf rdf:resource="https://example.org/ficto/Attribute"/>
        <rdfs:comment>The character and psychology includes: inner structure, emotions and affections, psychological physiognomy, self-assessment, etc.</rdfs:comment>
        <rdfs:label>Character and Psychology</rdfs:label>
    </owl:Class>

    <!-- https://example.org/ficto/Axiology -->
    <owl:Class rdf:about="https://example.org/ficto/Axiology">
        <rdfs:subClassOf rdf:resource="https://example.org/ficto/Attribute"/>
        <rdfs:comment>The axiologyincludes: outlook on life and values (ethical, religious, political), existential reflections, beliefs, attitudes towards the world and others, etc.</rdfs:comment>
        <rdfs:label>Axiology</rdfs:label>
    </owl:Class>

    <!-- https://example.org/ficto/Praxis -->
    <owl:Class rdf:about="https://example.org/ficto/Praxis">
        <rdfs:subClassOf rdf:resource="https://example.org/ficto/Attribute"/>
        <rdfs:comment>The axiologyincludes: actions and behaviour, attitudes, habits and tics, including communicative ones (manner of speaking, idiolect, gestures and facial expressions), etc.</rdfs:comment>
        <rdfs:label>Praxis</rdfs:label>
    </owl:Class>

    <!-- https://example.org/ficto/Modality -->
    <owl:Class rdf:about="https://example.org/ficto/Modality">
        <rdfs:subClassOf rdf:resource="https://example.org/ficto/Attribute"/>
        <rdfs:comment>The modality includes: will (needs, lacks, interests, curiosity, purposes, impositions and duties) and power (physical means, tools, skills, specific competence), etc.</rdfs:comment>
        <rdfs:label>Modality</rdfs:label>
    </owl:Class>

    <!-- https://example.org/ficto/Symbols -->
    <owl:Class rdf:about="https://example.org/ficto/Modality">
        <rdfs:subClassOf rdf:resource="https://example.org/ficto/Attribute"/>
        <rdfs:comment>The symbols includes: recurring personal objects (Recurring personal objects), Symbolic imagery (Symbolic imagery), Iconography and intertextual references (Iconography and intertextual references), etc.</rdfs:comment>
        <rdfs:label>Symbols</rdfs:label>
    </owl:Class>

    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

     <!-- http://rdaregistry.info/Elements/u/rdau:P60447 -->
    <owl:ObjectProperty rdf:about="http://rdaregistry.info/Elements/u/rdau:P60447">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F27_Work_Creation"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F55_Collective_Agent"/>
    </owl:ObjectProperty>

    <!-- http://rdaregistry.info/Elements/u/rdau:P60527 -->
    <owl:ObjectProperty rdf:about="http://rdaregistry.info/Elements/u/rdau:P60527">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F27_Work_Creation"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
    </owl:ObjectProperty>

    <!-- http://iflastandards.info/ns/lrm/lrmoo/R16_created -->
    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmoo/R16_created">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F27_Work_Creation"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F1_Work"/>
    </owl:ObjectProperty>

    <!-- http://iflastandards.info/ns/lrm/lrmoo/R17_created -->
    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmoo/R17_created">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
    </owl:ObjectProperty>

    <!-- http://iflastandards.info/ns/lrm/lrmoo/R3_is_realised_in -->
    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmoo/R3_is_realised_in">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F1_Work"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
    </owl:ObjectProperty>

    <!-- http://www.cidoc-crm.org/cidoc-crm/P72_has_language -->
    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P72_has_language">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E56_Language"/>
    </owl:ObjectProperty>

    <!-- http://rdaregistry.info/Elements/u/rdau:P61020 -->
    <owl:ObjectProperty rdf:about="http://rdaregistry.info/Elements/u/rdau:P61020">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
    </owl:ObjectProperty>

    <!-- http://rdaregistry.info/Elements/u/rdau:P60385 -->
    <owl:ObjectProperty rdf:about="http://rdaregistry.info/Elements/u/rdau:P60385">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F55_Collective_Agent"/>
    </owl:ObjectProperty>

    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasRole -->
    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasRole">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F38_Character"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Role"/>
    </owl:ObjectProperty>

    <!-- https://example.org/ficto/isInspiredBy -->
    <owl:ObjectProperty rdf:about="https://example.org/ficto/isInspiredBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F38_Character"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F38_Character"/>
        <rdfs:comment>This property expresses an inspiration from a fictional character to another fictional character.</rdfs:comment>
        <rdfs:label>is Inspired By</rdfs:label>
    </owl:ObjectProperty>

    <!-- http://iflastandards.info/ns/lrm/lrmoo/R75_is_based_on -->
    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmoo/R75_is_based_on">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F38_Character"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
    </owl:ObjectProperty>

    <!-- https://example.org/ficto/hasPointOfView -->
    <owl:ObjectProperty rdf:about="https://example.org/ficto/hasPointOfView">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/Narrator"/>
        <rdfs:range rdf:resource="https://example.org/ficto/Focalization"/>
        <rdfs:comment>This property expresses the position of the narrator in relation to the narrated story.</rdfs:comment>
        <rdfs:label>has Point Of View</rdfs:label>
    </owl:ObjectProperty>

    <!-- https://example.org/ficto/hasPerspective -->
    <owl:ObjectProperty rdf:about="https://example.org/ficto/hasPerspective">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/NarrativeSegment"/>
        <rdfs:range rdf:resource="https://example.org/ficto/Narrator"/>
        <rdfs:comment>This property allows to specify the perspective of a narrative segment from which the story conveys information.</rdfs:comment>
        <rdfs:label>has Perspective</rdfs:label>
    </owl:ObjectProperty>

    <!-- https://example.org/ficto/involves -->
    <owl:ObjectProperty rdf:about="https://example.org/ficto/involves">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/NarrativeSegment"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F38_Character"/>
        <rdfs:comment>This property expresses the possible presence of a character within a narrative segment.</rdfs:comment>
        <rdfs:label>involves</rdfs:label>
    </owl:ObjectProperty>

    <!-- https://example.org/ficto/hasAttribute -->
    <owl:ObjectProperty rdf:about="https://example.org/ficto/hasAttribute">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F38_Character"/>
        <rdfs:range rdf:resource="https://example.org/ficto/Attribute"/>
        <rdfs:comment>This property allows to specify attributes of a character.</rdfs:comment>
        <rdfs:label>has Attribute</rdfs:label>
    </owl:ObjectProperty>

    <!-- https://example.org/ficto/linkedTo -->
    <owl:ObjectProperty rdf:about="https://example.org/ficto/linkedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ficto/Attribute"/>
        <rdfs:range rdf:resource="https://example.org/ficto/Genre"/>
        <rdfs:comment>This property expresses a possible link between character attribute and the literary genre of reference.</rdfs:comment>
        <rdfs:label>linked To</rdfs:label>
    </owl:ObjectProperty>

    <!-- http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of -->
    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of">
        <rdfs:domain rdf:resource="https://example.org/ficto/Diegesis"/>
        <rdfs:range rdf:resource="https://example.org/ficto/NarrativeSegment"/>
    </owl:ObjectProperty>

    <!-- http://www.cidoc-crm.org/cidoc-crm/P94_has_created -->
    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P94_has_created">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
        <rdfs:range rdf:resource="https://example.org/ficto/Diegesis"/>
    </owl:ObjectProperty>

    <!-- http://purl.org/spar/cito/cites -->
    <owl:ObjectProperty rdf:about="http://purl.org/spar/cito/cites">
        <rdfs:domain rdf:resource="https://example.org/ficto/NarrativeSegment"/>
        <rdfs:range rdf:resource="https://example.org/ficto/Attribute"/>
    </owl:ObjectProperty>

    <!-- https://example.org/ficto/hasFormOfSpeech -->
    <owl:ObjectProperty rdf:about="https://example.org/ficto/hasFormOfSpeech">
        <rdfs:domain rdf:resource="https://example.org/ficto/NarrativeSegment"/>
        <rdfs:range rdf:resource="https://example.org/ficto/FormOfSpeech"/>
        <rdfs:comment>This property allows to specify the type of speech of a narrative segment.</rdfs:comment>
        <rdfs:label>has Source Type</rdfs:label>
    </owl:ObjectProperty>

    <!-- http://www.cidoc-crm.org/cidoc-crm/P2_type-->
    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P2_type">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
    </owl:ObjectProperty>

    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- https://example.org/ficto/hasTextualTransmission -->
    <owl:DatatypeProperty rdf:about="https://example.org/ficto/hasTextualTransmission">
        <rdfs:domain rdf:resource="https://example.org/ficto/Attribute"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>

    <!-- http://www.w3.org/ns/prov#value -->
    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#value">
        <rdfs:domain rdf:resource="https://example.org/ficto/NarrativeSegment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- https://example.org/ficto/foc-zero -->
    <owl:NamedIndividual rdf:about="https://example.org/ficto/foc-zero">
        <rdf:type rdf:resource="https://example.org/ficto/Focalization"/>
        <rdfs:comment>When the narrator is omniscent.</rdfs:comment>
        <rdfs:label>foc zero</rdfs:label>
    </owl:NamedIndividual>

    <!-- https://example.org/ficto/foc-external -->
    <owl:NamedIndividual rdf:about="https://example.org/ficto/foc-external">
        <rdf:type rdf:resource="https://example.org/ficto/Focalization"/>
        <rdfs:comment>When the narrator is a character of the story.</rdfs:comment>
        <rdfs:label>foc external</rdfs:label>
    </owl:NamedIndividual>

    <!-- https://example.org/ficto/foc-internal -->
    <owl:NamedIndividual rdf:about="https://example.org/ficto/foc-internal">
        <rdf:type rdf:resource="https://example.org/ficto/Focalization"/>
        <rdfs:comment>When the narrator knows and tells less then a character of the story.</rdfs:comment>
        <rdfs:label>fox internal</rdfs:label>
    </owl:NamedIndividual>

    <!-- https://example.org/ficto/subject -->
    <owl:NamedIndividual rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Role">
        <rdf:type rdf:resource="https://w3id.org/sebi/Evaluation"/>
        <rdfs:comment>The one who acts to conquer the Object.</rdfs:comment>
        <rdfs:label>subject</rdfs:label>
    </owl:NamedIndividual>

    <!-- https://example.org/ficto/object -->
    <owl:NamedIndividual rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Role">
        <rdf:type rdf:resource="https://w3id.org/sebi/Evaluation"/>
        <rdfs:comment>Point of confluence of the action of the Subject.</rdfs:comment>
        <rdfs:label>object</rdfs:label>
    </owl:NamedIndividual>

    <!-- https://example.org/ficto/destinator -->
    <owl:NamedIndividual rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Role">
        <rdf:type rdf:resource="https://w3id.org/sebi/Evaluation"/>
        <rdfs:comment>Who places the Object as an object of desire and value.</rdfs:comment>
        <rdfs:label>destinator</rdfs:label>
    </owl:NamedIndividual>

    <!-- https://example.org/ficto/helper -->
    <owl:NamedIndividual rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Role">
        <rdf:type rdf:resource="https://w3id.org/sebi/Evaluation"/>
        <rdfs:comment>Who helps the subject to conquer the object.</rdfs:comment>
        <rdfs:label>helper</rdfs:label>
    </owl:NamedIndividual>

    <!-- https://example.org/ficto/opposer -->
    <owl:NamedIndividual rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Role">
        <rdf:type rdf:resource="https://w3id.org/sebi/Evaluation"/>
        <rdfs:comment>Who hinders the subject towards the conquest of the object.</rdfs:comment>
        <rdfs:label>opposer</rdfs:label>
    </owl:NamedIndividual>

    <!-- https://example.org/ficto/recipient -->
    <owl:NamedIndividual rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Role">
        <rdf:type rdf:resource="https://w3id.org/sebi/Evaluation"/>
        <rdfs:comment>Who benefits from the Object.</rdfs:comment>
        <rdfs:label>recipient</rdfs:label>
    </owl:NamedIndividual>

    <!-- https://example.org/ficto/apocryphal -->
    <owl:NamedIndividual rdf:about="https://example.org/ficto/apocryphal">
        <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:comment>A apocryphal is a non-authentic, non-genuine book, writing, or document.</rdfs:comment>
        <rdfs:label>apocryphal</rdfs:label>
    </owl:NamedIndividual>

    <!-- https://example.org/ficto/pastiche -->
    <owl:NamedIndividual rdf:about="https://example.org/ficto/pastiche">
        <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:comment>A pastiche is generally a work composed, in whole or in large part, of excerpts from pre-existing works, mostly with imitative intent.</rdfs:comment>
        <rdfs:label>pastiche</rdfs:label>
    </owl:NamedIndividual>

    <!-- https://example.org/ficto/translation -->
    <owl:NamedIndividual rdf:about="https://example.org/ficto/translation">
        <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:comment>Translated versions of a text.</rdfs:comment>
        <rdfs:label>translation</rdfs:label>
    </owl:NamedIndividual>

    <!-- https://example.org/ficto/free-indirect-style -->
    <owl:NamedIndividual rdf:about="https://example.org/ficto/free-indirect-style">
        <rdf:type rdf:resource="https://example.org/ficto/FormOfSpeech"/>
        <rdfs:comment>The narrator's speech imitates that of the character.</rdfs:comment>
        <rdfs:label>free indirect style</rdfs:label>
    </owl:NamedIndividual>

    <!-- https://example.org/ficto/direct-speech -->
    <owl:NamedIndividual rdf:about="https://example.org/ficto/direct-speech">
        <rdf:type rdf:resource="https://example.org/ficto/FormOfSpeech"/>
        <rdfs:comment>The narrator gives the floor to the character.</rdfs:comment>
        <rdfs:label>direct speech</rdfs:label>
    </owl:NamedIndividual>

    <!-- https://example.org/ficto/narrated-speech -->
    <owl:NamedIndividual rdf:about="https://example.org/ficto/narration-statement">
        <rdf:type rdf:resource="https://example.org/ficto/FormOfSpeech"/>
