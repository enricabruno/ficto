<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.44> a ficto:NarrativeSegment ;
    cito:cites ficto:attitude_5 ;
    prov:value "«Era talmente assorto nell’operazione che sembrava essersi dimenticato della nostra presenza, visto che monologava sottovoce tutto il tempo, con un fuoco di fila di esclamazioni, grugniti, fischi e gridolini di giubilo e incoraggiamento»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
