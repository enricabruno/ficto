    cito:cites ficto:recur_p_obj_1,
        ficto:recur_p_obj_2 ;
    prov:value "«Non aveva ancora finito di parlare che tirò fuori di tasca un metro a nastro e una grossa lente d'ingrandimento»"^^xsd:string ;
