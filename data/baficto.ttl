<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.49> a ficto:NarrativeSegment ;
    cito:cites ficto:exist_outlook_3 ;
    prov:value "«La nostra anima conserva vaghi ricordi di quei secoli nebulosi in cui il mondo era ancora nella sua infanzia»"^^xsd:string ;
