<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.1> a ficto:NarrativeSegment ;
    cito:cites ficto:full_name_1,
        ficto:inter_1,
        ficto:psych_prof_1 ;
    prov:value "«Non conosce ancora Sherlock Holmes. Forse non le andrà a genio come compagno fisso». «Perché, cos’ha che non va?» «Oh, non ho detto che ci sia qualcosa che non va in lui. Solo che è un tantino stravagante. È un fanatico di alcuni settori della scienza. Comunque mi risulta che sia un tipo abbastanza a posto»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.10> a ficto:NarrativeSegment ;
    cito:cites ficto:habit_4,
        ficto:habit_5 ;
    prov:value "«C’era quasi da sospettare che facesse uso di droghe se non ci fosse stata a smentirlo la sua vita sana e morigerata»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.11> a ficto:NarrativeSegment ;
    cito:cites ficto:feature_1,
        ficto:feature_2 ;
    prov:value "«Era alto più di un metro e ottanta, e talmente magro da sembrare ancor più allampanato»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:narr_seg_expr1.12 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.12> a ficto:NarrativeSegment ;
    cito:cites ficto:feature_3,
        ficto:feature_4 ;
    prov:value "«Lo sguardo era acuto e penetrante, a parte i succitati periodi di torpore, e il suo affilato naso aquilino conferiva al viso un’espressione decisa e attenta»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.13> a ficto:NarrativeSegment ;
    cito:cites ficto:feature_5 ;
    prov:value "«Anche il mento, pronunciato e quadrato, denotava una persona dal carattere volitivo»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.14> a ficto:NarrativeSegment ;
    cito:cites ficto:feature_6 ;
    prov:value "«Le mani erano costantemente chiazzate d’inchiostro e di macchie da sostanze chimiche, eppure aveva un tocco straordinariamente delicato»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.15> a ficto:NarrativeSegment ;
    cito:cites ficto:psych_prof_2 ;
    prov:value "«Forse il lettore mi giudicherà un tremendo ficcanaso, ma confesso che quell'uomo stimolava la mia curiosità. Tentai a più riprese di lacerare la cortina di reticenza dietro cui si trincerava per tutto quanto riguardava la sua persona»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.16> a ficto:NarrativeSegment ;
    cito:cites ficto:occupation_1,
        ficto:occupation_2 ;
    prov:value "«Holmes non studiava medicina»"^^xsd:string,
        "«Né sembrava frequentare alcun corso valevole per una laurea nelle materie scientifiche o qualunque altra via di accesso al mondo accademico»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.17> a ficto:NarrativeSegment ;
    cito:cites ficto:aspiration_1,
        ficto:knowledge_3 ;
    prov:value "«Eppure il suo zelo in certi campi era notevole, e la sua cultura, entro limiti non meglio precisati, talmente vasta e dettagliata che certe sue osservazioni mi sorprendevano»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.18> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_3,
        ficto:knowledge_4 ;
    prov:value "«La sua ignoranza era notevole quanto il sapere»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.19> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_5,
        ficto:knowledge_6,
        ficto:knowledge_7,
        ficto:knowledge_8 ;
    prov:value "«Ma il mio stupore giunse al colmo quando scoprii per caso che ignorava la teoria copernicana e la struttura del sistema solare»"^^xsd:string,
        "«Sembrava conoscere poco o nulla di letteratura, filosofia e politica»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.2> a ficto:NarrativeSegment ;
    cito:cites ficto:attitude_1,
        ficto:knowledge_1,
        ficto:skill_1 ;
    prov:value "«Credo che sia discretamente ferrato in anatomia, ed è un chimico coi fiocchi. […] I suoi studi sono caotici ed estemporanei. Ha accumulato un sacco di nozioni curiose che lascerebbero a bocca aperta i suoi professori»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.20> a ficto:NarrativeSegment ;
    cito:cites ficto:exist_outlook_1,
        ficto:knowledge_5 ;
    prov:value "«SHERLOCK HOLMES: Letteratura: zero»"^^xsd:string,
        "«Sa, ritengo che all'inizio il cervello dell'uomo sia simile a un solaio vuoto, che devi riempire con tutta la mobilia che ti va,» spiegò. «Lo sciocco ci sbatte dentro tutto il ciarpame che gli capita [...]. Invece l'operatore esperto sta molto attento a quello che butta nella testa-solaio. [...] Mi creda, viene il momento in cui per ogni nozione che ci aggiunge dimenticherà qualcosa che sapeva prima. Pertanto è fondamentale evitare i dati inutili che tolgono spazio a quelli utili»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech,
        ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.21> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_1,
        ficto:knowledge_10,
        ficto:knowledge_11,
        ficto:knowledge_12,
        ficto:knowledge_13,
        ficto:knowledge_2,
        ficto:knowledge_6,
        ficto:knowledge_7,
        ficto:knowledge_9,
        ficto:skill_2,
        ficto:skill_3 ;
    prov:value "«SHERLOCK HOLMES: Anatomia: accurata, ma poco sistematica»"^^xsd:string,
        "«SHERLOCK HOLMES: Astronomia: zero»"^^xsd:string,
        "«SHERLOCK HOLMES: Chimica: profonda»"^^xsd:string,
        "«SHERLOCK HOLMES: Cronaca nera: sterminata. Sembra che conosca i minimi dettagli di tutti i crimini orrendi perpetrati nel secolo»"^^xsd:string,
        "«SHERLOCK HOLMES: Filosofia: zero»"^^xsd:string,
        "«SHERLOCK HOLMES: Ha una discreta conoscenza pratica delle leggi britanniche»"^^xsd:string,
        "«SHERLOCK HOLMES: Politica: poco o nulla»"^^xsd:string,
        "«SHERLOCK HOLMES: Suona molto bene il violino»"^^xsd:string,
        "«SHERLOCK HOLMES: è provetto spadaccino e pugile ed esperto di lotta con i bastoni»"^^xsd:string,
        "«SHERLOCK HOLMES:Botanica: a seconda. Ferrato su belladonna, oppio e veleni in genere. Non sa nulla di giardinaggio pratico»"^^xsd:string,
        "«SHERLOCK HOLMES:Geologia: pratica ma limitata. Sa distinguere alla prima occhiata un tipo di terreno dall’altro. Dopo le sue passeggiate mi ha mostrato gli schizzi di fango sui pantaloni, spiegando in base al colore e alla consistenza da quale zona di Londra provenivano»"^^xsd:string .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.22> a ficto:NarrativeSegment ;
    cito:cites ficto:habit_6,
        ficto:habit_7,
        ficto:mannerism_1 ;
    prov:value "«Di solito alla sera abbassava le palpebre, si accasciava contro lo schienale della poltrona, e grattava distrattamente le corde del violino posato sulle ginocchia»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.23> a ficto:NarrativeSegment ;
    cito:cites ficto:habit_6 ;
    prov:value "«Talvolta erano accordi armoniosi e malinconici, talvolta fantasiosi e allegri. Riflettevano chiaramente i pensieri in cui era immerso, ma non riuscivo a capire se la musica li aiutava o se quello strimpellare era soltanto frutto di un capriccio o di una fantasia»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.24> a ficto:NarrativeSegment ;
    cito:cites ficto:skill_1 ;
    prov:value "«Se non erro, ho accennato alla sua maestria con il violino. Era davvero notevole, ma stravagante come tutti gli altri suoi talenti»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.25> a ficto:NarrativeSegment ;
    cito:cites ficto:occupation_3 ;
    prov:value "«Ogni volta si scusava con me per l'incomodo dicendo: «Sono costretto a usare questa stanza a mo' di ufficio. Sa', sono i miei clienti»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.26> a ficto:NarrativeSegment ;
    cito:cites ficto:exist_outlook_2 ;
    prov:value "«L'autore sosteneva che una fugace espressione, il guizzo di un muscolo o un'occhiata potevano bastare a interpretare i pensieri più riposti. A parer suo era impossibile fingere e mentire a una persona addestrata all'analisi e all'osservazione. Le conclusioni a cui arrivava l'autore suonavano indiscutibili come altrettanti teoremi di Euclide, e i risultati ottenibili sarebbero apparsi così stupefacenti a un profano da fargli sospettare di essere in presenza di uno stregone, almeno finché non gli fosse stato spiegato il metodo grazie al quale questi li aveva conseguiti»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:indirect-style ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.27> a ficto:NarrativeSegment ;
    cito:cites ficto:exist_outlook_2 ;
    prov:value "«Da una goccia d'acqua una persona logica può dedurre la possibile esistenza dell'Atlantico o delle cascate del Niagara senza aver visto o udito ne l'uno né le altre,» sosteneva l'autore. «Così tutta la vita è una grande catena la cui natura ci si svela ogni volta che ce ne mostrano un solo anello. Come tutte le arti, la Scienza della deduzione e analisi può essere acquisita soltanto dopo studi lunghi e pazienti, e la vita non è abbastanza lunga da permettere a un qualsiasi mortale di arrivare alla perfezione. Prima di affrontare gli aspetti morali e intellettuali dell'argomento che presentano le maggiori difficoltà, l'analista deve partire dai problemi più elementari, per esempio imparare durante l'incontro con un suo simile a distinguere alla prima occhiata il passato di quell'individuo e il suo lavoro o professione. Anche se potrebbe sembrare un esercizio puerile, affina le facoltà di osservazione e insegna dove dobbiamo guardare e cosa cercare. Dale unghie di un uomo, dalla manica della giacca, dagli stivali, dai pantaloni, dai calli su pollice. eindice, dall'espresisone del viso, dai polsini, da ognuna di queste cose possiamo facilmente ricavare la professione di un uomo. È inconcepibile che tutto questo messo assieme non basti a illuminare l'analista competente in tutti i tipi di indagine»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:indirect-style ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.28> a ficto:NarrativeSegment ;
    cito:cites ficto:expertise_2,
        ficto:expertise_3 ;
    prov:value "«Sì. Sono molto portato sia all'osservazione che alla deduzione»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.29> a ficto:NarrativeSegment ;
    cito:cites ficto:occupation_4 ;
    prov:value "«Le teorie che ho esposto in quelle pagine, e che le sembrano chimeriche, sono in realtà estremamente pratiche... tanto che sono loro a fornirmi pane e companatico»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.3> a ficto:NarrativeSegment ;
    cito:cites ficto:psych_prof_2,
        ficto:psych_prof_3 ;
    prov:value "«No, non è uno che si sbottona molto, anche se può essere abbastanza espansivo quando gli salta il ticchio»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.30> a ficto:NarrativeSegment ;
    cito:cites ficto:occupation_4 ;
    prov:value "«Mah, il mio è un lavoro abbastanza speciale. Credo di essere l’unico al mondo. Sono un consulente nelle indagini […]. Quando costoro [investigatori] si trovano in difficoltà, vengono da me [..]. Loro mi elencano tutti gli indizi che hanno, e di solito io riesco a metterli sulla pista giusta grazie alla mia conoscenza della storia del crimine»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.31> a ficto:NarrativeSegment ;
    cito:cites ficto:expertise_4 ;
    prov:value "«Mi sta dicendo che, senza uscire di casa, è in grado di risolvere enigmi insolubili per gli altri […]?»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.32> a ficto:NarrativeSegment ;
    cito:cites ficto:expertise_2 ;
    prov:value "«All’incirca. Ho questo tipo di intuito. Ogni tanto mi portano un caso un tantino più complesso e mi tocca mettere il naso fuori di casa per vedere le cose con i miei occhi. […] Per me le doti di osservazione sono una seconda natura […]»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.33> a ficto:NarrativeSegment ;
