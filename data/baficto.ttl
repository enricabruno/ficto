    cito:cites ficto:expertise_5 ;
    prov:value "«Tutto ciò, comunque, esula dalla missione di cui lei mi ha incaricato, e molto probabilmente risulterà del tutto privo di interesse per una mente rigorosamente pratica come la sua»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:indirect-style ;
