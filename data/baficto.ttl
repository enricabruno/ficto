<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.35> a ficto:NarrativeSegment ;
    cito:cites ficto:self_perception_1 ;
    prov:value "«[...] andai alla finestra e mi misi a guardare la strada trafficata, dicendomi che quel tipo era forse molto astuto, ma sicuramente si dava troppe arie»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.36> a ficto:NarrativeSegment ;
    cito:cites ficto:aspiration_1 ;
    prov:value "«A che serve avere cervello nella nostra professione? So benissimo di avere la stoffa per diventare famoso. non c'è né c'è mai stato nessun altro che abbia investito la medesima quantità di studio e doti naturali nella soluzione dei crimini»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.37> a ficto:NarrativeSegment ;
    cito:cites ficto:mannerism_2,
        ficto:mannerism_3 ;
    prov:value "«Quando mi girai verso di lui, Holmes aveva finito di leggere il messaggio. Il suo sguardo era neutro e spento, segno che era impegnato a riflettere»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.38> a ficto:NarrativeSegment ;
    cito:cites ficto:attitude_2,
        ficto:attitude_3 ;
    prov:value "«Non so ancora se ci andrò [sul luogo del crimine a Lauriston Gardens]. Sono il più inguaribile pigro che sia mai apparso sulla terra, o meglio, quando mi prendono quelle crisi, perché talvolta so essere parecchio dinamico»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.39> a ficto:NarrativeSegment ;
    cito:cites ficto:pers_style_1,
        ficto:psych_prof_4,
        ficto:psych_prof_5 ;
    prov:value "«S'infilo in fretta il soprabito, muovendosi con una celerità che dimostrava come alla fase di abulia fosse subentrata una crisi di iperattivismo»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.4> a ficto:NarrativeSegment ;
    cito:cites ficto:behaviour_1,
        ficto:principle_1 ;
    prov:value "«Non è facile spiegare l’inspiegabile» […] «Holmes è un tantino troppo scienziato per i miei gusti… rasenta l’animale a sangue freddo. […] Pare che sia uno sfegatato paladino del sapere esatto e specifico»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.40> a ficto:NarrativeSegment ;
    cito:cites ficto:attitude_4,
        ficto:exp_habit_1,
        ficto:kin_habit_2 ;
    prov:value "«Con un’aria noncurante che mi sembrava rasentare l’affettazione, fece avanti e indietro lungo il marciapiede, guardando con espressione assente il terreno, il cielo, le case di fronte e la staccionata […]. Si fermò due volte, e in un caso lo vidi sorridere mentre lanciava un’esclamazione soddisfatta»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.41> a ficto:NarrativeSegment ;
    cito:cites ficto:expertise_1 ;
    prov:value "«Tuttavia avevo avuto così clamorose conferme di quanto fossero fulminee le sue capacità percettive che non dubitavo fosse in grado di scorgere tante cose a me nascoste»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.42> a ficto:NarrativeSegment ;
    cito:cites ficto:kin_habit_3 ;
    prov:value "«Mentre parlava le sue agili dita svolazzavano dappertutto, premendo, tastando, sbottonando, esaminando, anche se gli occhi mantenevano la medesima espressione assente […]»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

