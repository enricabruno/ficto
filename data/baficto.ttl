<https://example.org/ficto/NarrativeSegment/narr_seg_expr5.6> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_5 ;
    prov:value "«Holmes - Si tratta comunque di beghe meschine, indegne di un gentleman. I prestiti, gli scambi, i rimbalzi di temi e personaggi da un autore all’altro, hanno sempre fatto parte del gioco letterario»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_5.1 ;
    ficto:involves ficto:sherlock_doyle5 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr5.7> a ficto:NarrativeSegment ;
    cito:cites ficto:psych_prof_20 ;
    prov:value "«Holmes (fantomatico) - Escogitò da vivo, ma preferì tacere da morto»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_5.1 ;
    ficto:involves ficto:sherlock_doyle5 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr5.8> a ficto:NarrativeSegment ;
    cito:cites ficto:expertise_3 ;
    prov:value "«ll quale ha cominciato a dubitare (come Holmes e Dupin deducono facilmente da sua espressione) che tanta rassomiglianza sia dovuta puro caso»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_5.1 ;
    ficto:involves ficto:sherlock_doyle5 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr5.9> a ficto:NarrativeSegment ;
    cito:cites ficto:attitude_15 ;
    prov:value "«Vediamo allora Holmes rabbuiarsi, e capiamo subito perché»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_5.1 ;
    ficto:involves ficto:sherlock_doyle5 .

