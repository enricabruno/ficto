    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.5> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_2 ;
    prov:value "«Lei è un’enciclopedia ambulante del crimine, se non sempre irriverente», disse Stamford con una risata. «Potrebbe fondare una rivista sull’argomento, e chiamarla ‘Annali del delitto’». «E sarebbe una lettura molto interessante», ribatté Sherlock Holmes […]»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.50> a ficto:NarrativeSegment ;
    cito:cites ficto:habit_6 ;
    prov:value "«Quando tornai con la pistola, la tavola era stata sparecchiata e Holmes era impegnato nella sua attività prediletta, strimpellare il violino»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.51> a ficto:NarrativeSegment ;
    cito:cites ficto:pers_style_2,
        ficto:pers_style_3 ;
    prov:value "«Rispuntò qualche secondo dopo avvolto in un cappottone e una sciarpa»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.52> a ficto:NarrativeSegment ;
    cito:cites ficto:exp_habit_2 ;
    prov:value "«Appena Holmes entrò gli lessi in faccia che aveva fatto cilecca. Sembrava combattuto tra ilarità e depressione, poi prevalse la prima e si lasciò andare a un grassa risata»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.53> a ficto:NarrativeSegment ;
    cito:cites ficto:mannerism_5,
        ficto:mannerism_6 ;
    prov:value "«Continuava a fare su e giù per la stanza, con il mento affondato nel petto e le sopracciglia aggrottate, come era solito fare quando rifletteva»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.54> a ficto:NarrativeSegment ;
    cito:cites ficto:kin_habit_4 ;
    prov:value "«Signori, vi presento Jefferson Hope, l’assassino di Enoch Drebber e Joseph Stangerson», esclamò con gli occhi che mandavano lampi»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.55> a ficto:NarrativeSegment ;
    cito:cites ficto:symb_imag_4 ;
    prov:value "«Ma prima che potesse passare del tutto Gregson, Lestrade e Holmes gli balzarono addosso come tanti cani da caccia»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.56> a ficto:NarrativeSegment ;
    cito:cites ficto:exp_habit_3 ;
    prov:value "«[…] Per quanto semplice, aveva parecchi punti assai istruttivi»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.57> a ficto:NarrativeSegment ;
    cito:cites ficto:kin_habit_2 ;
    prov:value "«Semplice?» Esclamai. «Davvero, non saprei come descriverlo in altro modo» disse Holmes, con un sorriso notando il mio stupore."^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.58> a ficto:NarrativeSegment ;
    cito:cites ficto:exist_outlook_2 ;
    prov:value "«Le ho già spiegato che quanto esula dall'ordinario è più una guida che un ostacolo. Quando devi risolvere un problema del genere è essenziale saper ragionare a ritroso. È una tecnica molto utile, e molto semplice, eppure la gente non la mette quasi mai in pratica. Negli affari di tutti i giorni conviene più ragionare dal presente al futuro, mentre l'inverso, dal presente al passato, tende a essere trascurato. Ci sono cinquanta persone che ragionano in maniera sintetica per una che sa ragionare analiticamente»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.6> a ficto:NarrativeSegment ;
    cito:cites ficto:emo_state_1,
        ficto:habit_1,
        ficto:habit_2 ;
    prov:value "«Spero non le dia fastidio l’odore del tabacco forte». […] «Perfetto. Di solito tengo in casa un po' di sostanze chimiche e ogni tanto faccio qualche piccolo esperimento. La disturba?» […] «Vediamo. Quali sono gli altri miei difetti? Talvolta vado soggetto a crisi di depressione e non apro bocca per giorni e giorni […]»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.7> a ficto:NarrativeSegment ;
    cito:cites ficto:expertise_1 ;
    prov:value "«A proposito, come diavolo faceva a sapere che vengo dall'Afghanistan?» domandai d'un tratto, fermandomi e girandomi verso Stamford. Il mio compagno fece un sorriso enigmatico. «È la sua piccola peculiarità. Non le dico quante sono le persone che vorrebbero sapere come fa a scoprire le cose»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.8> a ficto:NarrativeSegment ;
    cito:cites ficto:habit_3 ;
    prov:value "«Era un tipo tranquillo, dalle abitudini regolari»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr1.9> a ficto:NarrativeSegment ;
    cito:cites ficto:psych_prof_4,
        ficto:psych_prof_5 ;
    prov:value "«Non c’era sforzo superiore alle sue energie quando lo prendeva un accesso di attivismo, ma ogni tanto cadeva preda di una reazione contraria e rimaneva sdraiato per giorni di fila sul divano del salotto»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_1.1 ;
    ficto:involves ficto:sherlock_doyle1 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr2.1> a ficto:NarrativeSegment ;
    cito:cites ficto:full_name_1,
        ficto:habit_8,
        ficto:habit_9 ;
    prov:value "«Sherlock Holmes, che aveva l’abitudine di alzarsi molto tardi al mattino, tranne quando, come spesso capitava, rimaneva in piedi tutta la notte, era seduto a tavola per la prima colazione»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_2.1 ;
    ficto:involves ficto:sherlock_doyle2 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr2.10> a ficto:NarrativeSegment ;
    cito:cites ficto:habit_6 ;
    prov:value "«[…] Posso chiederle di passarmi il violino e rimandare ogni ulteriore considerazione sull’argomento a domattina[…]?»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:direct-speech ;
    ficto:hasNarrativeInstance ficto:narrator_2.1 ;
    ficto:involves ficto:sherlock_doyle2 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr2.11> a ficto:NarrativeSegment ;
    cito:cites ficto:pers_style_4 ;
    prov:value "«Il nostro tavolo della prima colazione era già stato sparecchiato da tempo, e Holmes aspettava in veste da camera il colloquio che ci era stato promesso»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_2.1 ;
    ficto:involves ficto:sherlock_doyle2 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr2.12> a ficto:NarrativeSegment ;
    cito:cites ficto:psych_prof_6,
        ficto:psych_prof_7 ;
    prov:value "«Holmes si trasformò istantaneamente da languido sognatore in energico uomo d’azione»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_2.1 ;
    ficto:involves ficto:sherlock_doyle2 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr2.13> a ficto:NarrativeSegment ;
    cito:cites ficto:attitude_8 ;
    prov:value "«Sherlock Holmes possedeva in sommo grado la capacità di estraniarsi mentalmente, a suo piacere, dai problemi che lo affliggevano»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_2.1 ;
    ficto:involves ficto:sherlock_doyle2 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr2.14> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_14 ;
    prov:value "«Non fece altro che parlare d’arte, argomento circa il quale aveva peraltro idee piuttosto audaci, dal momento in cui lasciammo la galleria fino a quando ci ritrovammo davanti al Northumberland Hotel»"^^xsd:string ;
    ficto:hasFormOfSpeech ficto:narrated-speech ;
    ficto:hasNarrativeInstance ficto:narrator_2.1 ;
    ficto:involves ficto:sherlock_doyle2 .

<https://example.org/ficto/NarrativeSegment/narr_seg_expr2.15> a ficto:NarrativeSegment ;
    cito:cites ficto:self_perception_3 ;
    prov:value "«La fama del suo amico detective è giunta fino a noi, e lei non poteva scriverne senza acquistare a sua volta notorietà»"^^xsd:string ;
