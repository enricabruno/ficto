<https://example.org/ficto/Narrative/narr_seg_expr_2.19> a ficto:NarrativeSegment ;
    cito:cites ficto:exp_habit_10,
        ficto:exp_habit_11,
        ficto:exp_habit_12 ;
    prov:value "«Quella voce fredda, incisiva, ironica, poteva appartenere a un solo uomo sulla faccia della terra»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
