<https://example.org/ficto/Narrative/narr_seg_expr_1.68> a ficto:NarrativeSegment ;
    cito:cites ficto:exp_habit_9 ;
    prov:value "«[…] Per quanto semplice, aveva parecchi punti assai istruttivi»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
