<https://example.org/ficto/Narrative/narr_seg_expr_2.2> a ficto:NarrativeSegment ;
    cito:cites ficto:habit_1 ;
    prov:value "«Watson, lei ha davvero superato se stesso” esclamò Holmes, spingendo indietro la sedia e accendendosi una sigaretta»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
