        ficto:pers_style_4,
        ficto:recur_p_obj_3 ;
    prov:value "«Attraverso quella fitta cortina di fumo riuscivo a malapena a intravedere Holmes, raggomitolato su una poltrona con la veste da camera e con la sua pipa di terracotta nera tra le labbra»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
