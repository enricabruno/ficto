<https://example.org/ficto/Narrative/narr_seg_expr_1.27> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_10 ;
    prov:value "«SHERLOCK HOLMES:Botanica: a seconda. Ferrato su belladonna, oppio e veleni in genere. Non sa nulla di giardinaggio pratico»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.28> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_11 ;
    prov:value "«SHERLOCK HOLMES:Geologia: pratica ma limitata. Sa distinguere alla prima occhiata un tipo di terreno dall’altro. Dopo le sue passeggiate mi ha mostrato gli schizzi di fango sui pantaloni, spiegando in base al colore e alla consistenza da quale zona di Londra provenivano»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.29> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_12 ;
    prov:value "«SHERLOCK HOLMES: Chimica: profonda»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.3> a ficto:NarrativeSegment ;
    cito:cites ficto:psych_prof_2,
        ficto:psych_prof_3 ;
    prov:value "«No, non è uno che si sbottona molto, anche se può essere abbastanza espansivo quando gli salta il ticchio»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

