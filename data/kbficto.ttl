<https://example.org/ficto/Narrative/narr_seg_expr_1.61> a ficto:NarrativeSegment ;
    cito:cites ficto:methodology ;
    prov:value "«La nostra anima conserva vaghi ricordi di quei secoli nebulosi in cui il mondo era ancora nella sua infanzia»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
