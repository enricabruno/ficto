<https://example.org/ficto/Narrative/narr_seg_expr_1.35> a ficto:NarrativeSegment ;
    cito:cites ficto:habit_5,
        ficto:habit_6,
        ficto:mannerism_2 ;
    prov:value "«Di solito alla sera abbassava le palpebre, si accasciava contro lo schienale della poltrona, e grattava distrattamente le corde del violino posato sulle ginocchia»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.36> a ficto:NarrativeSegment ;
    cito:cites ficto:habit_5 ;
    prov:value "«Talvolta erano accordi armoniosi e malinconici, talvolta fantasiosi e allegri. Riflettevano chiaramente i pensieri in cui era immerso, ma non riuscivo a capire se la musica li aiutava o se quello strimpellare era soltanto frutto di un capriccio o di una fantasia»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.37> a ficto:NarrativeSegment ;
    cito:cites ficto:habit_5 ;
    prov:value "«Se non erro, ho accennato alla sua maestria con il violino. Era davvero notevole, ma stravagante come tutti gli altri suoi talenti»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.38> a ficto:NarrativeSegment ;
    cito:cites ficto:occupation_2 ;
    prov:value "«Ogni volta si scusava con me per l'incomodo dicendo: «Sono costretto a usare questa stanza a mo' di ufficio. Sa', sono i miei clienti»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.39> a ficto:NarrativeSegment ;
    cito:cites ficto:methodology ;
    prov:value "«L'autore sosteneva che una fugace espressione, il guizzo di un muscolo o un'occhiata potevano bastare a interpretare i pensieri più riposti. A parer suo era impossibile fingere e mentire a una persona addestrata all'analisi e all'osservazione. Le conclusioni a cui arrivava l'autore suonavano indiscutibili come altrettanti teoremi di Euclide, e i risultati ottenibili sarebbero apparsi così stupefacenti a un profano da fargli sospettare di essere in presenza di uno stregone, almeno finché non gli fosse stato spiegato il metodo grazie al quale questi li aveva conseguiti»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/indirect-style> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.4> a ficto:NarrativeSegment ;
    cito:cites ficto:methodology,
        ficto:principle ;
    prov:value "«Non è facile spiegare l’inspiegabile» […] «Holmes è un tantino troppo scienziato per i miei gusti… rasenta l’animale a sangue freddo. […] Pare che sia uno sfegatato paladino del sapere esatto e specifico»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.40> a ficto:NarrativeSegment ;
    cito:cites ficto:methodology ;
    prov:value "«Da una goccia d'acqua una persona logica può dedurre la possibile esistenza dell'Atlantico o delle cascate del Niagara senza aver visto o udito ne l'uno né le altre,» sosteneva l'autore. «Così tutta la vita è una grande catena la cui natura ci si svela ogni volta che ce ne mostrano un solo anello. Come tutte le arti, la Scienza della deduzione e analisi può essere acquisita soltanto dopo studi lunghi e pazienti, e la vita non è abbastanza lunga da permettere a un qualsiasi mortale di arrivare alla perfezione. Prima di affrontare gli aspetti morali e intellettuali dell'argomento che presentano le maggiori difficoltà, l'analista deve partire dai problemi più elementari, per esempio imparare durante l'incontro con un suo simile a distinguere alla prima occhiata il passato di quell'individuo e il suo lavoro o professione. Anche se potrebbe sembrare un esercizio puerile, affina le facoltà di osservazione e insegna dove dobbiamo guardare e cosa cercare. Dale unghie di un uomo, dalla manica della giacca, dagli stivali, dai pantaloni, dai calli su pollice. eindice, dall'espresisone del viso, dai polsini, da ognuna di queste cose possiamo facilmente ricavare la professione di un uomo. È inconcepibile che tutto questo messo assieme non basti a illuminare l'analista competente in tutti i tipi di indagine»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/indirect-style> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.41> a ficto:NarrativeSegment ;
    cito:cites ficto:expertise_2,
        ficto:expertise_3 ;
    prov:value "«Sì. Sono molto portato sia all'osservazione che alla deduzione»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.42> a ficto:NarrativeSegment ;
    cito:cites ficto:occupation_3 ;
    prov:value "«Le teorie che ho esposto in quelle pagine, e che le sembrano chimeriche, sono in realtà estremamente pratiche... tanto che sono loro a fornirmi pane e companatico»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.43> a ficto:NarrativeSegment ;
    cito:cites ficto:occupation_3 ;
    prov:value "«Mah, il mio è un lavoro abbastanza speciale. Credo di essere l’unico al mondo. Sono un consulente nelle indagini […]. Quando costoro [investigatori] si trovano in difficoltà, vengono da me [..]. Loro mi elencano tutti gli indizi che hanno, e di solito io riesco a metterli sulla pista giusta grazie alla mia conoscenza della storia del crimine»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.44> a ficto:NarrativeSegment ;
    cito:cites ficto:expertise_3 ;
    prov:value "«Mi sta dicendo che, senza uscire di casa, è in grado di risolvere enigmi insolubili per gli altri […]?»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.45> a ficto:NarrativeSegment ;
    cito:cites ficto:expertise_2 ;
    prov:value "«All’incirca. Ho questo tipo di intuito. Ogni tanto mi portano un caso un tantino più complesso e mi tocca mettere il naso fuori di casa per vedere le cose con i miei occhi. […] Per me le doti di osservazione sono una seconda natura […]»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.46> a ficto:NarrativeSegment ;
    cito:cites ficto:habit_2 ;
    prov:value "«Sherlock Holmes si alzò e accese la pipa»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.47> a ficto:NarrativeSegment ;
    cito:cites ficto:kin_habit_1 ;
    prov:value "«Sherlock Holmes sbuffò sprezzante, poi rispose stizzito [...]»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.48> a ficto:NarrativeSegment ;
    cito:cites ficto:self_perception ;
    prov:value "«[...] andai alla finestra e mi misi a guardare la strada trafficata, dicendomi che quel tipo era forse molto astuto, ma sicuramente si dava troppe arie»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.49> a ficto:NarrativeSegment ;
    cito:cites ficto:aspiration_1 ;
    prov:value "«A che serve avere cervello nella nostra professione? So benissimo di avere la stoffa per diventare famoso. non c'è né c'è mai stato nessun altro che abbia investito la medesima quantità di studio e doti naturali nella soluzione dei crimini»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.5> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_2 ;
    prov:value "«Lei è un’enciclopedia ambulante del crimine, se non sempre irriverente», disse Stamford con una risata. «Potrebbe fondare una rivista sull’argomento, e chiamarla ‘Annali del delitto’». «E sarebbe una lettura molto interessante», ribatté Sherlock Holmes […]»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.50> a ficto:NarrativeSegment ;
    cito:cites ficto:mannerism_1 ;
    prov:value "«Quando mi girai verso di lui, Holmes aveva finito di leggere il messaggio. Il suo sguardo era neutro e spento, segno che era impegnato a riflettere»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.51> a ficto:NarrativeSegment ;
    cito:cites ficto:attitude_2,
        ficto:attitude_3 ;
    prov:value "«Non so ancora se ci andrò [sul luogo del crimine a Lauriston Gardens]. Sono il più inguaribile pigro che sia mai apparso sulla terra, o meglio, quando mi prendono quelle crisi, perché talvolta so essere parecchio dinamico»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.52> a ficto:NarrativeSegment ;
    cito:cites ficto:pers_style_1,
        ficto:psych_prof_4,
        ficto:psych_prof_5 ;
    prov:value "«S'infilo in fretta il soprabito, muovendosi con una celerità che dimostrava come alla fase di abulia fosse subentrata una crisi di iperattivismo»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.53> a ficto:NarrativeSegment ;
    cito:cites ficto:attitude_4,
        ficto:exp_habit_1,
        ficto:kin_habit_2 ;
    prov:value "«Con un’aria noncurante che mi sembrava rasentare l’affettazione, fece avanti e indietro lungo il marciapiede, guardando con espressione assente il terreno, il cielo, le case di fronte e la staccionata […]. Si fermò due volte, e in un caso lo vidi sorridere mentre lanciava un’esclamazione soddisfatta»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.54> a ficto:NarrativeSegment ;
    cito:cites ficto:expertise_1 ;
    prov:value "«Tuttavia avevo avuto così clamorose conferme di quanto fossero fulminee le sue capacità percettive che non dubitavo fosse in grado di scorgere tante cose a me nascoste»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.55> a ficto:NarrativeSegment ;
    cito:cites ficto:kin_habit_3 ;
    prov:value "«Mentre parlava le sue agili dita svolazzavano dappertutto, premendo, tastando, sbottonando, esaminando, anche se gli occhi mantenevano la medesima espressione assente […]»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.56> a ficto:NarrativeSegment ;
    cito:cites ficto:recur_p_obj_1,
        ficto:recur_p_obj_2 ;
    prov:value "«Non aveva ancora finito di parlare che tirò fuori di tasca un metro a nastro e una grossa lente d'ingrandimento»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.57> a ficto:NarrativeSegment ;
    cito:cites ficto:attitude_5,
        ficto:exp_habit_2,
        ficto:exp_habit_3,
        ficto:exp_habit_4,
        ficto:exp_habit_5,
        ficto:exp_habit_6,
        ficto:exp_habit_7 ;
    prov:value "«Era talmente assorto nell’operazione che sembrava essersi dimenticato della nostra presenza, visto che monologava sottovoce tutto il tempo, con un fuoco di fila di esclamazioni, grugniti, fischi e gridolini di giubilo e incoraggiamento»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.58> a ficto:NarrativeSegment ;
    cito:cites ficto:symb_imag_1 ;
    prov:value "«Mi ricordava un bracco di razza ben addestrato che scatta a destra e a manca nel sottobosco […]»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.59> a ficto:NarrativeSegment ;
    cito:cites ficto:self_perception ;
    prov:value "«Il mio compagno arrossì, compiaciuto per le mie parole e per il tono convinto con cui le avevo pronunciate. Avevo già notato che era sensibile sulle sue doti quanto può esserlo una fanciulla riguardo la propria avvenenza»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.6> a ficto:NarrativeSegment ;
    cito:cites ficto:emo_state_1,
        ficto:habit_1,
        ficto:habit_2 ;
    prov:value "«Spero non le dia fastidio l’odore del tabacco forte». […] «Perfetto. Di solito tengo in casa un po' di sostanze chimiche e ogni tanto faccio qualche piccolo esperimento. La disturba?» […] «Vediamo. Quali sono gli altri miei difetti? Talvolta vado soggetto a crisi di depressione e non apro bocca per giorni e giorni […]»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.60> a ficto:NarrativeSegment ;
    cito:cites ficto:symb_imag_2,
        ficto:symb_imag_3 ;
    prov:value "«Il segugio dilettante attaccò a cantare come un’allodola, appoggiato allo schienale della carrozza […]»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
