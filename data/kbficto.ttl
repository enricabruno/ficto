<https://example.org/ficto/Narrative/narr_seg_expr_2.26> a ficto:NarrativeSegment ;
    cito:cites ficto:self_perception ;
    prov:value "«Il mio dovere di investigatore coscienzioso sarebbe quello di arrestare tutti gli abitanti della casa per favoreggiamento […]»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.27> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_14 ;
    prov:value "«Watson non ammetterà mai che io capisca qualcosa in fatto di arte, ma la sua è pura gelosia, dal momento che abbiamo punti di vista molto diversi in materia […]»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
