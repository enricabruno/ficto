    cito:cites ficto:need_1 ;
    prov:value "«Sapevo che il mio amico aveva bisogno di rimanere solo in quelle ore di intensa concentrazione in cui avrebbe soppesato ogni frammento di prova, costruito teorie alternative, confrontandole fra loro, e deciso quali punti fossero da considerare essenziali e quali trascurabili»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
