<https://example.org/ficto/Narrative/narr_seg_expr_1.64> a ficto:NarrativeSegment ;
    cito:cites ficto:exp_habit_8 ;
    prov:value "«Appena Holmes entrò gli lessi in faccia che aveva fatto cilecca. Sembrava combattuto tra ilarità e depressione, poi prevalse la prima e si lasciò andare a un grassa risata»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.65> a ficto:NarrativeSegment ;
    cito:cites ficto:mannerism_3,
        ficto:mannerism_4 ;
    prov:value "«Continuava a fare su e giù per la stanza, con il mento affondato nel petto e le sopracciglia aggrottate, come era solito fare quando rifletteva»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
