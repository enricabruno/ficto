    cito:cites ficto:expertise_2,
        ficto:self_perception ;
    prov:value "«Il me suffit de lire sur l'aspect extérieur des gens. C'est mon métier de mieux voir que le commun des mortels, et c'est pour ça que vous êtes venue me consulter, fit-il en riant»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_4.2> ;
