<https://example.org/ficto/Narrative/narr_seg_expr_2.23> a ficto:NarrativeSegment ;
    cito:cites ficto:feature_3 ;
    prov:value "«Holmes scattò in piedi e in un attimo vidi la sua sagoma scura, atletica, profilarsi sulla soglia […]»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.24> a ficto:NarrativeSegment ;
    cito:cites ficto:psych_prof_8 ;
    prov:value "«Dov’è?» sussurrò Holmes; capii, dal tremito della sua voce, che persino lui, l’uomo dai nervi d’acciaio, era profondamente turbato»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.25> a ficto:NarrativeSegment ;
    cito:cites ficto:psych_prof_8 ;
    prov:value "«Era mai possibile che quello fosse il mio severo amico, sempre così controllato e padrone di sé? C’era davvero un fuoco nascosto in lui!»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
