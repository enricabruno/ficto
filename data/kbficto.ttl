<https://example.org/ficto/Narrative/narr_seg_expr_2.28> a ficto:NarrativeSegment ;
    cito:cites ficto:methodology ;
    prov:value "«La prima qualità di un bravo criminologo è proprio quella di riconoscere un travestimento»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.29> a ficto:NarrativeSegment ;
    cito:cites ficto:exp_habit_8 ;
    prov:value "«Mentre si allontanava dal quadro, scoppiò in una delle sue rare risate. Lo avevo inteso ridere raramente, e il suo riso aveva ogni volta presagio di sciagura a qualcuno»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.3> a ficto:NarrativeSegment ;
    cito:cites ficto:recur_p_obj_2 ;
    prov:value "«Poi, con un’espressione di vivo interesse, posò la sigaretta, si avvicinò alla finestra e lo osservò nuovamente con una lente di ingrandimento»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.30> a ficto:NarrativeSegment ;
    cito:cites ficto:symb_imag_4 ;
    prov:value "«Mi sembra un generale che stia concertando un piano di battaglia insieme al proprio capo di stato maggiore»"^^xsd:string ;
