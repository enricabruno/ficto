    cito:cites ficto:pers_style_5,
        ficto:pers_style_6 ;
    prov:value "«Con il suo completo di tweed e il suo berretto di panno sembrava proprio uno dei tanti turisti che venivano in gita sulla brughiera»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
