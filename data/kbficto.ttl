<https://example.org/ficto/Narrative/narr_seg_expr_1.67> a ficto:NarrativeSegment ;
    cito:cites ficto:symb_imag_1 ;
    prov:value "«Ma prima che potesse passare del tutto Gregson, Lestrade e Holmes gli balzarono addosso come tanti cani da caccia»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
