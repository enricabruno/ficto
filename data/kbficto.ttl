<https://example.org/ficto/Narrative/narr_seg_expr_1.1> a ficto:NarrativeSegment ;
    cito:cites ficto:inter_1,
        ficto:name,
        ficto:psych_prof_1 ;
    prov:value "«Non conosce ancora Sherlock Holmes. Forse non le andrà a genio come compagno fisso». «Perché, cos’ha che non va?» «Oh, non ho detto che ci sia qualcosa che non va in lui. Solo che è un tantino stravagante. È un fanatico di alcuni settori della scienza. Comunque mi risulta che sia un tipo abbastanza a posto»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.10> a ficto:NarrativeSegment ;
    cito:cites ficto:habit_3,
        ficto:habit_4 ;
    prov:value "«C’era quasi da sospettare che facesse uso di droghe se non ci fosse stata a smentirlo la sua vita sana e morigerata»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.11> a ficto:NarrativeSegment ;
    cito:cites ficto:feature_1,
        ficto:feature_2 ;
    prov:value "«Era alto più di un metro e ottanta, e talmente magro da sembrare ancor più allampanato»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/narr_seg_expr1.12> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.12> a ficto:NarrativeSegment ;
    cito:cites ficto:feature_3,
        ficto:mannerism_1 ;
    prov:value "«Lo sguardo era acuto e penetrante, a parte i succitati periodi di torpore, e il suo affilato naso aquilino conferiva al viso un’espressione decisa e attenta»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.13> a ficto:NarrativeSegment ;
    cito:cites ficto:feature_3 ;
    prov:value "«Anche il mento, pronunciato e quadrato, denotava una persona dal carattere volitivo»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.14> a ficto:NarrativeSegment ;
    cito:cites ficto:feature_3 ;
    prov:value "«Le mani erano costantemente chiazzate d’inchiostro e di macchie da sostanze chimiche, eppure aveva un tocco straordinariamente delicato»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.15> a ficto:NarrativeSegment ;
    cito:cites ficto:psych_prof_2 ;
    prov:value "«Forse il lettore mi giudicherà un tremendo ficcanaso, ma confesso che quell'uomo stimolava la mia curiosità. Tentai a più riprese di lacerare la cortina di reticenza dietro cui si trincerava per tutto quanto riguardava la sua persona»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.16> a ficto:NarrativeSegment ;
    cito:cites ficto:occupation_1 ;
    prov:value "«Holmes non studiava medicina»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.17> a ficto:NarrativeSegment ;
    cito:cites ficto:occupation_1 ;
    prov:value "«Né sembrava frequentare alcun corso valevole per una laurea nelle materie scientifiche o qualunque altra via di accesso al mondo accademico»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.18> a ficto:NarrativeSegment ;
    cito:cites ficto:attitude_17,
        ficto:knowledge_3 ;
    prov:value "«Eppure il suo zelo in certi campi era notevole, e la sua cultura, entro limiti non meglio precisati, talmente vasta e dettagliata che certe sue osservazioni mi sorprendevano»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.19> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_3,
        ficto:knowledge_4 ;
    prov:value "«La sua ignoranza era notevole quanto il sapere»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.2> a ficto:NarrativeSegment ;
    cito:cites ficto:attitude_1,
        ficto:habit_2,
        ficto:knowledge_1 ;
    prov:value "«Credo che sia discretamente ferrato in anatomia, ed è un chimico coi fiocchi. […] I suoi studi sono caotici ed estemporanei. Ha accumulato un sacco di nozioni curiose che lascerebbero a bocca aperta i suoi professori»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.20> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_5,
        ficto:knowledge_6,
        ficto:knowledge_7 ;
    prov:value "«Sembrava conoscere poco o nulla di letteratura, filosofia e politica»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.21> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_8 ;
    prov:value "«Ma il mio stupore giunse al colmo quando scoprii per caso che ignorava la teoria copernicana e la struttura del sistema solare»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.22> a ficto:NarrativeSegment ;
    cito:cites ficto:methodology ;
    prov:value "«Sa, ritengo che all'inizio il cervello dell'uomo sia simile a un solaio vuoto, che devi riempire con tutta la mobilia che ti va,» spiegò. «Lo sciocco ci sbatte dentro tutto il ciarpame che gli capita [...]. Invece l'operatore esperto sta molto attento a quello che butta nella testa-solaio. [...] Mi creda, viene il momento in cui per ogni nozione che ci aggiunge dimenticherà qualcosa che sapeva prima. Pertanto è fondamentale evitare i dati inutili che tolgono spazio a quelli utili»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle1> .

<https://example.org/ficto/Narrative/narr_seg_expr_1.23> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_5 ;
    prov:value "«SHERLOCK HOLMES: Letteratura: zero»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_1.1> ;
