<https://example.org/ficto/Narrative/narr_seg_expr_2.22> a ficto:NarrativeSegment ;
    cito:cites ficto:attitude_9 ;
    prov:value "«Inoltre, con quella pignola cura da gatto per la propria persona che era una delle sue caratteristiche, era riuscito a escogitare un sistema perché il suo mento fosse perfettamente rasato e la sua biancheria immacolata proprio come in Baker Street»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
