<https://example.org/ficto/Narrative/narr_seg_expr_4.1> a ficto:NarrativeSegment ;
    cito:cites ficto:expertise_1,
        ficto:name ;
    prov:value "«La plus étrange parmi ces affaires, toutes résolues grâce à l'habileté d e Sherlock Holmes, l'une des plus révélatrices aussi du talent de détection de mon illustre ami, me paraît être l'affaire du Loup chantant de Forest Gate»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_4.1> ;
