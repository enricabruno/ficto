<https://example.org/ficto/Narrative/narr_seg_expr_2.13> a ficto:NarrativeSegment ;
    cito:cites ficto:attitude_8 ;
    prov:value "«Sherlock Holmes possedeva in sommo grado la capacità di estraniarsi mentalmente, a suo piacere, dai problemi che lo affliggevano»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.14> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_14 ;
    prov:value "«Non fece altro che parlare d’arte, argomento circa il quale aveva peraltro idee piuttosto audaci, dal momento in cui lasciammo la galleria fino a quando ci ritrovammo davanti al Northumberland Hotel»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.15> a ficto:NarrativeSegment ;
    cito:cites ficto:self_perception ;
    prov:value "«La fama del suo amico detective è giunta fino a noi, e lei non poteva scriverne senza acquistare a sua volta notorietà»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.16> a ficto:NarrativeSegment ;
    cito:cites ficto:expertise_4 ;
    prov:value "«Tutto ciò, comunque, esula dalla missione di cui lei mi ha incaricato, e molto probabilmente risulterà del tutto privo di interesse per una mente rigorosamente pratica come la sua»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/indirect-style> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.17> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_8 ;
    prov:value "«Ricordo ancora la sua totale indifferenza alla questione se fosse il sole a girare intorno alla terra o la terra intorno al sole»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/indirect-style> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.18> a ficto:NarrativeSegment ;
    cito:cites ficto:belief_1 ;
    prov:value "«Holmes non darebbe certamente retta a simili fandonie, e io sono qui per suo incarico»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/reported-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
