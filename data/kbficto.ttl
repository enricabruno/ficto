    cito:cites ficto:name,
        ficto:skill_2 ;
    prov:value "«È col cuore gonfio che prendo in mano la penna per tracciare queste che saranno le ultime parole che scriverò per narrare le doti singolari che sempre distinsero il mio amico Sherlock Holmes»"^^xsd:string ;
