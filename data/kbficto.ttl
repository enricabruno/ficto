<https://example.org/ficto/Narrative/narr_seg_expr_1.62> a ficto:NarrativeSegment ;
    cito:cites ficto:habit_5 ;
    prov:value "«Quando tornai con la pistola, la tavola era stata sparecchiata e Holmes era impegnato nella sua attività prediletta, strimpellare il violino»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
