    cito:cites ficto:attitude_14,
        ficto:expertise_3 ;
    prov:value "«Moi-même, habitué pourtant aux stupéfiants facilités de déduction de mon co-locataire, comme à son innocente manie d’étonner la galerie […]»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
