        ficto:pers_style_9,
        ficto:recur_p_obj_2 ;
    prov:value "«Stanno poi sorbendo i loro cappuccini quando un uomo alto, ben riconoscibile dal mantello a larghe pieghe e dal singolare berretto, viene a esaminare le loro targhette con una grossa lente - Permettete? Holmes, - dice presentando anche il suo compagno, sul risvolto del quale si legge: «Dr. Watson»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_5.1> ;
