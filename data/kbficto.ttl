    cito:cites ficto:emo_state_4,
        ficto:emo_state_5,
        ficto:expertise_2 ;
    prov:value "«l'hébétude de Sherlock Holmes n'était qu'apparente et son état de prostration physique et mentale n'empêchait nullement le prodigieux cerveau de noter le plus infime détail»"^^xsd:string ;
