<https://example.org/ficto/Narrative/narr_seg_expr_2.31> a ficto:NarrativeSegment ;
    cito:cites ficto:knowledge_2 ;
    prov:value "«Gli studiosi di criminologia rammenteranno senz’altro gli episodi analoghi avvenuti nel 1866 a Grodno, nella Piccola Russia, e naturalmente i delitti Anderson nella Carolina del Nord; ma questo caso presenta caratteristiche assolutamente uniche»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.32> a ficto:NarrativeSegment ;
    cito:cites ficto:psych_prof_2 ;
    prov:value "«Uno dei difetti di Sherlock Holmes, dato e non concesso che si trattasse di un difetto, era quello di essere estremamente restio a comunicare a chiunque altro i suoi piani fino al momento stesso della loro attuazione»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.33> a ficto:NarrativeSegment ;
    cito:cites ficto:attitude_10,
        ficto:expertise_6 ;
    prov:value "«Questo era dovuto in parte, senza dubbio, alla sua natura autoritaria, che si compiaceva nel dominare e sorprendere coloro che gli stavano interno; in parte alla sua prudenza professionale, che gli imponeva di non correre mai rischi inutili»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.34> a ficto:NarrativeSegment ;
    cito:cites ficto:mannerism_1,
        ficto:mannerism_5 ;
    prov:value "«Ma all’improvviso li vidi irrigidirsi in uno sguardo fisso, come impietrito, mentre le labbra si spalancarono per lo stupore»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.35> a ficto:NarrativeSegment ;
    cito:cites ficto:psych_prof_9 ;
    prov:value "«Avevo atteso pazientemente l’occasione propizia, sapendo che non ammetteva mai che un suo caso si sovrapponesse a un altro, e che la sua mente logica e razionale non si lasciava distogliere dall’indagine in corso per riandare ai ricordi del passato»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.36> a ficto:NarrativeSegment ;
    cito:cites ficto:methodology ;
    prov:value "«Più un particolare sembra grottesco e stravagante, più vale la pena di esaminarlo attentamente, e proprio ciò che apparentemente complica un caso, se analizzato a fondo e vagliato con metodo scientifico, diventa elemento che finisce per chiarirlo»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.37> a ficto:NarrativeSegment ;
    cito:cites ficto:inter_2 ;
    prov:value "«Una domanda interessante, ma temo che pretenda troppo se si aspetta che sappia risponderle. Il passato e il presente rientrano nella mia sfera d’indagine, ma quello che una persona farà in futuro è davvero difficile saperlo»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.4> a ficto:NarrativeSegment ;
    cito:cites ficto:expression_1 ;
    prov:value "«Interessante, per quanto elementare,» concluse, tirando a sedersi nel suo angolo preferito del divano»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
    ficto:involves <https://example.org/ficto/Character/sherlock_doyle2> .

<https://example.org/ficto/Narrative/narr_seg_expr_2.5> a ficto:NarrativeSegment ;
    cito:cites ficto:occupation_3 ;
    prov:value "«[…] Che cosa vorrà mai il dottor James Mortimer, uomo di scienza, da Sherlock Holmes, specialista del crimine? Avanti!»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/direct-speech> ;
