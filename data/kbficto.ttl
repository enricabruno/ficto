<https://example.org/ficto/Narrative/narr_seg_expr_2.12> a ficto:NarrativeSegment ;
    cito:cites ficto:psych_prof_6,
        ficto:psych_prof_7 ;
    prov:value "«Holmes si trasformò istantaneamente da languido sognatore in energico uomo d’azione»"^^xsd:string ;
    ficto:hasFormOfSpeech <https://example.org/ficto/FormOfSpeech/narrated-speech> ;
    ficto:hasNarrativeInstance <https://example.org/ficto/Narrator/narrator_2.1> ;
